# Hobby Server Monitor configuration. Copy to .env (git-ignored) and fill in.
# Values marked SECRET must never be committed. Units are in the names.
# Every variable is read by hsm/config.py; anything not listed here does not exist.

# --- Public address -------------------------------------------------------
# Origin the browser uses. Unsafe requests must carry exactly this Origin.
PUBLIC_BASE_URL=http://localhost:8000
# local-http: plain HTTP, only allowed for a localhost PUBLIC_BASE_URL (development).
# https: Secure + __Host- cookies, HSTS; put the API behind the reverse proxy in deploy/.
HSM_DEPLOYMENT_MODE=local-http

# --- Google OAuth 2.0 / OpenID Connect -----------------------------------------
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web application).
GOOGLE_OAUTH_CLIENT_ID=
# SECRET
GOOGLE_OAUTH_CLIENT_SECRET=
# Must exactly match an "Authorized redirect URI" of the client. Defaults to PUBLIC_BASE_URL + this path.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/auth/google/callback

# --- Sessions -----------------------------------------------------------------
# SECRET. Keys the CSRF token derivation (sessions themselves are random server-side tokens).
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=
SESSION_ABSOLUTE_HOURS=8
SESSION_IDLE_MINUTES=30
INVITATION_TTL_HOURS=72

# --- First administrator ------------------------------------------------------
# Only this Google account can complete bootstrap, and only with the one-time link
# printed by `hsm bootstrap` (valid 30 minutes, usable once, never again after completion).
BOOTSTRAP_ADMIN_EMAIL=

# --- Storage --------------------------------------------------------------------
# Directory for app.db, metrics/ and history.sock. Must be on a Linux filesystem (not /mnt/c).
HSM_DATA_DIR=./data
# Optional overrides (default to files inside HSM_DATA_DIR):
# SQLITE_DB_PATH=./data/app.db
# TINYFLUX_DB_PATH=./data/metrics
# HSM_HISTORY_SOCKET=./data/history.sock
# Comma-separated UIDs allowed to query the collector's history socket (default: own UID).
# In the systemd deployment this is the UID of the hsm-api user.
# HSM_HISTORY_ALLOWED_UIDS=
# Built Astro site served by the API (default: dashboard/dist).
# HSM_DASHBOARD_DIST=./dashboard/dist

# --- LXD --------------------------------------------------------------------------
# Unix socket used by the worker and collector only. The API never opens it.
LXD_SOCKET=/var/snap/lxd/common/lxd/unix.socket
# Restricted project where new containers are created (see scripts/setup-dev-host.sh).
LXD_PROJECT=hsm
LXD_TIMEOUT_SECONDS=10
# Operator allowlists for what the create form may offer (comma-separated).
HSM_ALLOWED_POOLS=hsm-btrfs
HSM_ALLOWED_NETWORKS=hsmbr0
# Only local images whose alias starts with this prefix are offered.
HSM_IMAGE_ALIAS_PREFIX=hsm/
# Hard per-container process limit (limits.processes); fork-bomb damage control.
CONTAINER_MAX_PROCESSES=500

# --- Capacity reserves (never allocated to containers) ------------------------------
HSM_HOST_CPU_RESERVE=1
HSM_HOST_MEMORY_RESERVE_BYTES=1073741824
HSM_POOL_RESERVE_BYTES=2147483648
# Budget for unmanaged containers that have no CPU/memory limit. While such containers
# exist and these are 0, new allocations are blocked (accounting would be incomplete).
HSM_EXTERNAL_RESERVE_CPU_CORES=0
HSM_EXTERNAL_RESERVE_MEMORY_BYTES=0

# --- Collector and metric retention --------------------------------------------------
COLLECTOR_POLL_INTERVAL_SECONDS=10
METRICS_RAW_RETENTION_HOURS=6
# Five-minute rollups are kept this long.
METRICS_RETENTION_DAYS=30
# Hard cap on metric files, and free space the collector always leaves on the disk.
METRICS_MAX_BYTES=268435456
METRICS_MIN_FREE_BYTES=1073741824
# History API bounds (points per series is capped at 600 regardless).
HISTORY_MAX_POINTS=600
HISTORY_MAX_RANGE_DAYS=31

# --- Command execution ------------------------------------------------------------------
EXEC_MAX_COMMAND_BYTES=4096
EXEC_MAX_OUTPUT_BYTES=65536
EXEC_DEADLINE_SECONDS=20
EXEC_RESULT_TTL_MINUTES=15

# --- Housekeeping ----------------------------------------------------------------------
AUDIT_RETENTION_DAYS=90
OPERATION_RETENTION_DAYS=14

# --- API listener ------------------------------------------------------------------------
# Bind to loopback; expose through the reverse proxy only. Containers on the LXD bridge
# reach the host on the bridge address, not on 127.0.0.1.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
# Set to true only when the API sits behind the reverse proxy in deploy/Caddyfile (which
# replaces X-Forwarded-For). Rate limits then key on the client address the proxy appended.
HSM_TRUSTED_PROXY=false
